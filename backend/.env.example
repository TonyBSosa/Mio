NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/mio_dev
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO
CORS_ORIGINS=http://localhost:4200

APP_URL=http://localhost:4200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TRUST_PROXY_HOPS=0

# Confirmaciones exclusivamente en pruebas aisladas (nunca producción).
# Además exige NODE_ENV=test, base mio_pruebas_* y replica set/Atlas.
# El barrido reservas:expirar usa el mismo entorno aislado, aun con este flag apagado.
RESERVAS_PRUEBA_HABILITADAS=false
RESERVAS_PRUEBA_VENDEDORES=

# Solo backend. Bucket privado dedicado; nunca copiar la clave a Angular.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COMPROBANTES_BUCKET=
